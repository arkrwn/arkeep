<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent template for mikvaultd.

  Copy to ~/Library/LaunchAgents/com.mikvault.mikvaultd.plist, replace every
  REPLACE_WITH_USER, then load it:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.mikvault.mikvaultd.plist
  See docs/deployment.md for the full install procedure.

  launchd does not expand ~ or $HOME inside this file, so the absolute home
  paths below must be written out.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikvault.mikvaultd</string>

    <!-- Installed binary. Adjust if you installed it somewhere else. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/mikvaultd</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Where vault.mika, meta.json, host.seal and audit.jsonl live. -->
        <key>MIKVAULT_DATA_DIR</key>
        <string>/Users/REPLACE_WITH_USER/Library/Application Support/mikvault</string>
        <!-- Unix socket the daemon listens on. The parent directory must exist. -->
        <key>MIKVAULT_SOCKET</key>
        <string>/Users/REPLACE_WITH_USER/Library/Application Support/mikvault/mikvault.sock</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_WITH_USER/Library/Application Support/mikvault</string>
</dict>
</plist>
