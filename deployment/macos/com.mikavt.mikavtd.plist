<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent template for mikavtd.

  Copy to ~/Library/LaunchAgents/com.mikavt.mikavtd.plist, replace every
  REPLACE_WITH_USER, then load it:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.mikavt.mikavtd.plist
  See docs/deployment.md for the full install procedure.

  launchd does not expand ~ or $HOME inside this file, so the absolute home
  paths below must be written out.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikavt.mikavtd</string>

    <!-- Installed binary. Adjust if you installed it somewhere else. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/mikavtd</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Where vault.mika, meta.json, host.seal and audit.jsonl live. -->
        <key>MIKAVT_DATA_DIR</key>
        <string>/Users/REPLACE_WITH_USER/Library/Application Support/mikavt</string>
        <!-- Unix socket the daemon listens on. The parent directory must exist. -->
        <key>MIKAVT_SOCKET</key>
        <string>/Users/REPLACE_WITH_USER/Library/Application Support/mikavt/mikavtd.sock</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_WITH_USER/Library/Application Support/mikavt</string>
</dict>
</plist>
