# systemd unit template for mikavtd.
#
# Copy to /etc/systemd/system/mikavtd.service, replace every
# REPLACE_WITH_HOST_ID with the id you passed to `mikavt init --host`, then
# `systemctl daemon-reload && systemctl enable --now mikavtd`.
# See docs/deployment.md for the full install procedure.
[Unit]
Description=mikavt secrets vault daemon
Documentation=https://github.com/arkrwn/mikavt/blob/main/docs/deployment.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
# Dedicated unprivileged account; create it first (see docs/deployment.md).
User=mikavt
Group=mikavt

# Installed binary. Adjust if you installed it somewhere else.
ExecStart=/usr/local/bin/mikavtd

# This host's unseal key (ADR 0009). systemd decrypts the sealed blob AS
# ROOT before starting the daemon and exposes the plaintext only to this
# unit, at $CREDENTIALS_DIRECTORY/mikavt-<host id>, on a private tmpfs.
# mikavtd itself never needs access to systemd-creds' root-only host secret.
# The credential name must be "mikavt-<host id>" — the name
# `mikavt init --host` sealed it under.
LoadCredentialEncrypted=mikavt-REPLACE_WITH_HOST_ID:/var/lib/mikavt/hosts/REPLACE_WITH_HOST_ID.seal
Environment=MIKAVT_HOST_ID=REPLACE_WITH_HOST_ID

# Where vault.mika, meta.json, hosts/ and audit.jsonl live.
Environment=MIKAVT_DATA_DIR=/var/lib/mikavt
# Unix socket the daemon listens on. The directory is created by RuntimeDirectory.
# Socket is mikavt:mikavt, mode 0660; add consuming services' users to the mikavt group.
Environment=MIKAVT_SOCKET=/run/mikavt/mikavtd.sock

# Server mode (ADR 0008), optional. Uncomment to also listen on TLS/TCP.
# Keep the key file readable only by root/mikavt.
#Environment=MIKAVT_TLS_ADDR=0.0.0.0:8443
#Environment=MIKAVT_TLS_CERT=/etc/mikavt/tls/server.pem
#Environment=MIKAVT_TLS_KEY=/etc/mikavt/tls/server.key
#Environment=MIKAVT_TLS_CLIENT_CA=/etc/mikavt/tls/client-ca.pem

# Creates /run/mikavt owned by User=mikavt. Group members need traverse
# access to reach the socket.
RuntimeDirectory=mikavt
RuntimeDirectoryMode=0750
# Creates /var/lib/mikavt owned by User=mikavt (the only writable path).
StateDirectory=mikavt
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=5

# --- Hardening -----------------------------------------------------------
# A secrets daemon must never leave key material in a core dump.
LimitCORE=0
# No privileges at all: no capabilities, no way to gain any.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Filesystem: everything read-only except StateDirectory/RuntimeDirectory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Kernel and process isolation.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Only the socket families mikavtd uses (Unix socket; TCP for server mode).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
