# systemd unit template for cofferakd.
#
# Copy to /etc/systemd/system/cofferakd.service and edit the marked lines.
# See docs/deployment.md for the full install procedure.
[Unit]
Description=cofferak secrets vault daemon
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
# Dedicated unprivileged account; create it first (see docs/deployment.md).
User=cofferak
Group=cofferak

# Installed binary. Adjust if you installed it somewhere else.
ExecStart=/usr/local/bin/cofferakd

# Where vault.cofferak, meta.json, host.seal and audit.jsonl live. host.seal is the
# systemd-creds sealed host key, read directly by cofferakd (see docs/deployment.md).
Environment=COFFERAK_DATA_DIR=/var/lib/cofferak
# Unix socket the daemon listens on. The directory is created by RuntimeDirectory.
# Socket is cofferak:cofferak, mode 0660; add consuming services to the cofferak group.
Environment=COFFERAK_SOCKET=/run/cofferak/cofferakd.sock

# Creates /run/cofferak owned by User=cofferak. Group members need traverse
# access to reach the socket.
RuntimeDirectory=cofferak
RuntimeDirectoryMode=0750
# Creates /var/lib/cofferak owned by User=cofferak.
StateDirectory=cofferak
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=5

# Basic hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
