# systemd unit template for arkeepd.
#
# Copy to /etc/systemd/system/arkeepd.service, replace every
# REPLACE_WITH_HOST_ID with the id you passed to `arkeep init --host`, then
# `systemctl daemon-reload && systemctl enable --now arkeepd`.
# See docs/deployment.md for the full install procedure.
[Unit]
Description=arkeep secrets vault daemon
Documentation=https://github.com/arkrwn/arkeep/blob/main/docs/deployment.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
# Dedicated unprivileged account; create it first (see docs/deployment.md).
User=arkeep
Group=arkeep

# Installed binary. Adjust if you installed it somewhere else.
ExecStart=/usr/local/bin/arkeepd

# This host's unseal key (ADR 0009). systemd decrypts the sealed blob AS
# ROOT before starting the daemon and exposes the plaintext only to this
# unit, at $CREDENTIALS_DIRECTORY/arkeep-<host id>, on a private tmpfs.
# arkeepd itself never needs access to systemd-creds' root-only host secret.
# The credential name must be "arkeep-<host id>" — the name
# `arkeep init --host` sealed it under.
LoadCredentialEncrypted=arkeep-REPLACE_WITH_HOST_ID:/var/lib/arkeep/hosts/REPLACE_WITH_HOST_ID.seal
Environment=ARKEEP_HOST_ID=REPLACE_WITH_HOST_ID

# Where vault.arkeep, meta.json, hosts/ and audit.jsonl live.
Environment=ARKEEP_DATA_DIR=/var/lib/arkeep
# Unix socket the daemon listens on. The directory is created by RuntimeDirectory.
# Socket is arkeep:arkeep, mode 0660; add consuming services' users to the arkeep group.
Environment=ARKEEP_SOCKET=/run/arkeep/arkeepd.sock

# Server mode (ADR 0008), optional. Uncomment to also listen on TLS/TCP.
# Keep the key file readable only by root/arkeep.
#Environment=ARKEEP_TLS_ADDR=0.0.0.0:8443
#Environment=ARKEEP_TLS_CERT=/etc/arkeep/tls/server.pem
#Environment=ARKEEP_TLS_KEY=/etc/arkeep/tls/server.key
#Environment=ARKEEP_TLS_CLIENT_CA=/etc/arkeep/tls/client-ca.pem

# Creates /run/arkeep owned by User=arkeep. Group members need traverse
# access to reach the socket.
RuntimeDirectory=arkeep
RuntimeDirectoryMode=0750
# Creates /var/lib/arkeep owned by User=arkeep (the only writable path).
StateDirectory=arkeep
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=5

# --- Hardening -----------------------------------------------------------
# A secrets daemon must never leave key material in a core dump.
LimitCORE=0
# No privileges at all: no capabilities, no way to gain any.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Filesystem: everything read-only except StateDirectory/RuntimeDirectory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Kernel and process isolation.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Only the socket families arkeepd uses (Unix socket; TCP for server mode).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
