# systemd unit template for mikvaultd.
#
# Copy to /etc/systemd/system/mikvaultd.service and edit the marked lines.
# See docs/deployment.md for the full install procedure.
[Unit]
Description=mikvault secrets vault daemon
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
# Dedicated unprivileged account; create it first (see docs/deployment.md).
User=mikvault
Group=mikvault

# Installed binary. Adjust if you installed it somewhere else.
ExecStart=/usr/local/bin/mikvaultd

# Where vault.mika, meta.json, host.seal and audit.jsonl live. host.seal is the
# systemd-creds sealed host key, read directly by mikvaultd (see docs/deployment.md).
Environment=MIKVAULT_DATA_DIR=/var/lib/mikvault
# Unix socket the daemon listens on. The directory is created by RuntimeDirectory.
# Socket is mikvault:mikvault, mode 0660; add consuming services to the mikvault group.
Environment=MIKVAULT_SOCKET=/run/mikvault/mikvaultd.sock

# Creates /run/mikvault owned by User=mikvault. Group members need traverse
# access to reach the socket.
RuntimeDirectory=mikvault
RuntimeDirectoryMode=0750
# Creates /var/lib/mikvault owned by User=mikvault.
StateDirectory=mikvault
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=5

# Basic hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
