# systemd unit template for mikvaultd.
#
# Copy to /etc/systemd/system/mikvaultd.service and edit the marked lines.
# See docs/deployment.md for the full install procedure.
[Unit]
Description=mikvault secrets vault daemon
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
# Dedicated unprivileged account; create it first (see docs/deployment.md).
User=mikvault
Group=mikvault

# Installed binary. Adjust if you installed it somewhere else.
ExecStart=/usr/local/bin/mikvaultd

# Host unseal key, sealed with systemd-creds. Created by `systemd-creds encrypt`
# (see docs/deployment.md). Delivered to the unit in $CREDENTIALS_DIRECTORY
# and never written to disk unsealed.
LoadCredentialEncrypted=mikvault_host_key:/etc/mikvault/host.cred

# Where vault.mika, meta.json, host.seal and audit.jsonl live.
Environment=MIKVAULT_DATA_DIR=/var/lib/mikvault
# Unix socket the daemon listens on. The directory is created by RuntimeDirectory.
Environment=MIKVAULT_SOCKET=/run/mikvault/mikvault.sock

# Creates /run/mikvault owned by User=mikvault.
RuntimeDirectory=mikvault
RuntimeDirectoryMode=0750
# Creates /var/lib/mikvault owned by User=mikvault.
StateDirectory=mikvault
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=5

# Basic hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
